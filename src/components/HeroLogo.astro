---
/**
 * <HeroLogo lang> — the home opens with the Montreal Model mark drawing itself: the stem first, then
 * the base appears, the two cloud outlines are drawn from the bottom corners up and over the lobes,
 * and the hearts' tips come last; the title follows. The mark is the exact vector reconstruction of
 * the logo (see public/images/mm-logo.svg). Reduced motion / no JS: the mark is simply shown.
 */
import logo from '../assets/mm-logo.svg?raw';
export interface Props { lang: string }
const { lang } = Astro.props;
const fr = lang === 'fr';
const alt = fr ? 'Logo du Modèle de Montréal : deux cœurs en nuage, du rouge au bleu' : 'Montreal Model logo: two heart-shaped clouds, red to blue';
// name the parts: stroked paths = left outline, right outline, stem, left tip, right tip; filled = base, two fillets
const named = logo
  .replace(/<svg /, '<svg class="hero-logo__svg" ')
  .replace(/<g fill="none"/, '<g class="hero-logo__strokes" fill="none"')
  .replace(/<g fill="url\(#mmg\)"/, '<g class="hero-logo__fills" fill="url(#mmg)"');
---
<div class="hero-logo" data-hero-logo role="img" aria-label={alt} set:html={named}></div>

<script>
  import { gsap } from 'gsap';
  import { DrawSVGPlugin } from 'gsap/DrawSVGPlugin';
  gsap.registerPlugin(DrawSVGPlugin);
  const init = () => {
    const box = document.querySelector<HTMLElement>('[data-hero-logo]');
    if (!box || box.dataset.ready) return; box.dataset.ready = '1';
    const after = [...document.querySelectorAll<HTMLElement>('.hero--mm .hero-after')];
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { box.classList.add('is-drawn'); return; }
    const strokes = [...box.querySelectorAll<SVGPathElement>('.hero-logo__strokes path')];
    const fills = [...box.querySelectorAll<SVGPathElement>('.hero-logo__fills path')];
    const [outerL, outerR, stem, tipL, tipR] = strokes;
    const [base, ...fillets] = fills;
    // One continuous gesture: the parts are chained at a constant internal speed (duration ∝ length,
    // each starting a hair before the previous one ends so nothing stops at the joints), and the whole
    // drawing is then played through a single soft ease-in-out — slow to start, slow to finish, no
    // change of pace in between. Each part fades in over its first moments so the round caps never pop.
    const len = (el: SVGPathElement) => el.getTotalLength();
    const baseHalf = 150;
    const total = len(stem) + baseHalf + len(outerL) + len(tipL);
    const d = (u: number) => u / total;                    // fraction of the whole gesture
    const ov = 0.03;                                        // overlap at the joints
    gsap.set(strokes, { drawSVG: '0%', opacity: 0 });
    gsap.set(base, { clipPath: 'inset(0 50% 0 50%)', opacity: 0 });
    gsap.set(fillets, { opacity: 0 });
    gsap.set(after, { opacity: 0, y: 14 });
    box.classList.add('is-drawn');
    const t1 = d(len(stem)), t2 = t1 + d(baseHalf) - ov, t3 = t2 + d(len(outerL)) - ov;
    const draw = gsap.timeline({ paused: true, defaults: { ease: 'none' } })
      .to(stem, { drawSVG: '0% 100%', duration: d(len(stem)) }, 0)
      .to(stem, { opacity: 1, duration: 0.06 }, 0)
      .to(base, { clipPath: 'inset(0 0% 0 0%)', duration: d(baseHalf) }, t1 - ov)
      .to(base, { opacity: 1, duration: 0.06 }, t1 - ov)
      .to(fillets, { opacity: 1, duration: 0.12 }, t1)
      .to([outerL, outerR], { drawSVG: '0% 100%', duration: d(len(outerL)) }, t2)
      .to([outerL, outerR], { opacity: 1, duration: 0.06 }, t2)
      .to([tipL, tipR], { drawSVG: '0% 100%', duration: d(len(tipL)) }, t3)
      .to([tipL, tipR], { opacity: 1, duration: 0.04 }, t3);
    gsap.to(draw, { progress: 1, duration: 2.2, ease: 'power2.inOut', delay: 0.3 });
    gsap.to(after, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.3, delay: 1.9, clearProps: 'transform' });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
