---
/**
 * <HeroReveal lang> — the home hero's opening: the Montreal Model mark is a window onto a slow,
 * luminous artwork (flowing ribbons in the logo's red → blue, "music and light"); after a beat the
 * window opens until the artwork fills the stage, then the title arrives beneath it.
 * Vector mark reconstructed from the raster logo (two heart-clouds, 29 px stroke, exact geometry).
 * Reduced motion / no JS: the artwork is shown open, with the mark drawn once on top.
 */
import { u } from '../lib/url';
import logo from '../assets/mm-logo.svg?raw';
import art from '../assets/hero-art.html?raw';
export interface Props { lang: string }
const { lang } = Astro.props;
const fr = lang === 'fr';
const alt = fr ? 'Logo du Modèle de Montréal : deux cœurs en nuage, du rouge au bleu' : 'Montreal Model logo: two heart-shaped clouds, red to blue';
---
<div class="reveal-stage" data-logo-reveal style={`--mask-url: url(${u('/images/mm-logo-mask.svg')})`} role="img" aria-label={alt}>
  <div class="reveal-stage__art" aria-hidden="true" data-parallax="0.08" data-parallax-max="40">
    <div class="art-glow art-glow--1"></div>
    <div class="art-glow art-glow--2"></div>
    <Fragment set:html={art} />
  </div>
  <div class="reveal-stage__logo" aria-hidden="true" set:html={logo}></div>
</div>

<script>
  import { gsap } from 'gsap';
  const init = () => {
    const stage = document.querySelector<HTMLElement>('[data-logo-reveal]');
    if (!stage || stage.dataset.ready) return; stage.dataset.ready = '1';
    const logo = stage.querySelector<HTMLElement>('.reveal-stage__logo');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const raw = getComputedStyle(stage).getPropertyValue('--ms-start').trim();
    const rem = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
    const start = raw.endsWith('rem') ? parseFloat(raw) * rem : (parseFloat(raw) || 160);
    const full = Math.max(stage.offsetWidth, stage.offsetHeight * 1.9) * 3.4;
    const after = [...document.querySelectorAll<HTMLElement>('.hero--mm .hero-after')];
    if (reduce) { stage.style.setProperty('--ms', `${full}px`); stage.classList.add('is-open'); return; }
    stage.style.setProperty('--ms', `${start}px`);
    gsap.set(after, { opacity: 0, y: 14 });
    gsap.timeline({ delay: 0.55 })
      .to(stage, { '--ms': `${full}px`, duration: 2.1, ease: 'power3.inOut' }, 0)
      .to(logo, { opacity: 0, duration: 0.6, ease: 'power2.out' }, 0.9)
      .add(() => stage.classList.add('is-open'), 1.6)
      .to(after, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.35, clearProps: 'transform' }, 1.0);
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
