---
/** Renders one Markdown entry from src/content/pages/<lang>/<slug>.md as a full page. */
import { Section } from '@pcl/design-system';
import PageHead from './PageHead.astro';
import { getEntry } from 'astro:content';
import { withBase, revealHeadings, revealLists } from '../lib/content';
import Shell from './Shell.astro';
import type { Lang } from '../site.config';

export interface Props { lang: Lang; slug: string; path: string; schema?: Record<string, unknown> }
const { lang, slug, path, schema } = Astro.props;
const entry = await getEntry('pages', `${lang}/${slug}`);
if (!entry) throw new Error(`Missing content: ${lang}/${slug}`);
const html = revealLists(revealHeadings(withBase(entry.rendered?.html ?? '')));
const d = entry.data;
---
<Shell lang={lang} path={path} title={d.seoTitle} description={d.description} schema={schema}>
  <main id="main">
    <PageHead eyebrow={d.eyebrow} title={d.title} lead={d.lead} />
    <Section>
      <div class="prose" set:html={html}></div>
    </Section>
    <slot />
  </main>
</Shell>
