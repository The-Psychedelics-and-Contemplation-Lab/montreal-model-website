---
import { Section } from '@pcl/design-system';
import PageHead from '../../components/PageHead.astro';
import Shell from '../../components/Shell.astro';
import { langPaths } from '../../lib/i18n';
import { media } from '../../content/data/publications';
import { u } from '../../lib/url';
export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const fr = lang === 'fr';
const meta = fr
  ? { title: 'Médias — Le modèle de Montréal', description: 'Le rayonnement du Modèle de Montréal : article à la une de La Presse canadienne, développements au Royaume-Uni, en Norvège et en Australie, balados et presse.' }
  : { title: 'Media Coverage — The Montreal Model of Ketamine Therapy', description: 'The reach of the Montreal Model: a featured La Presse canadienne article, developments in the UK, Norway and Australia, podcasts and press coverage.' };
const f = media.featured;
const intl = media.international;
---
<Shell lang={lang} path="/media-coverage/" title={meta.title} description={meta.description}>
  <main id="main">
    <PageHead eyebrow={fr ? 'Médias' : 'Media'} title={fr ? 'Médias' : 'Media Coverage'} lead={fr ? 'Suivez le rayonnement croissant du Modèle de Montréal dans les milieux cliniques, scientifiques et internationaux à travers les actualités, les médias et les publications institutionnelles.' : 'Follow the growing clinical, research, and international reach of the Montreal Model through news, media, and institutional features.'} />
    <Section>
      <h2 class="reveal-words">{fr ? 'À la une' : 'Featured'}</h2>
      <article class="featured reveal reveal--rise-lg" style="margin-top: var(--s-6)">
        <div class="featured__media"><img src={u(f.image)} alt={f.imageAlt[lang]} width="600" height="601" loading="lazy" decoding="async" /></div>
        <div class="featured__body">
          <p class="eyebrow">{f.outlet[lang]}</p>
          <h3 lang={f.lang}>{f.title}</h3>
          <p>{f.text[lang]}</p>
          <p class="featured__cta"><a href={f.url} target="_blank" rel="noopener noreferrer">{f.cta[lang]}</a></p>
        </div>
      </article>
    </Section>
    <Section band>
      <h2 class="reveal-words">{intl.heading[lang]}</h2>
      <p class="lead text-center intl__lead reveal reveal--blur">{intl.lead[lang]}</p>
      <div class="grid grid--3 intl reveal-group reveal-group--slow" style="margin-top: var(--s-8)">
        {intl.countries.map((c) => (
          <div class="intl__country">
            <h3>{c.name[lang]} <span aria-hidden="true">{c.flag}</span></h3>
            <p><strong>{c.title[lang]}</strong></p>
            <p>{c.text[lang]}</p>
            <p class="featured__cta"><a href={c.url} target="_blank" rel="noopener noreferrer">{c.cta[lang]}</a></p>
          </div>
        ))}
      </div>
    </Section>
    <Section>
      <h2 class="reveal-words">{fr ? 'Les Podcasts' : 'Podcasts'}</h2>
      <ul class="media-list reveal-group reveal-group--slow" style="margin-top: var(--s-6)">
        {media.podcasts.map((p) => (
          <li><a href={p.url} target="_blank" rel="noopener noreferrer" lang="en">{p.title}</a></li>
        ))}
      </ul>
    </Section>
    <Section band>
      <h2 class="reveal-words">{fr ? 'Dans l’actualité' : 'In the news'}</h2>
      <ul class="media-list reveal-group reveal-group--slow" style="margin-top: var(--s-6)">
        {media.news.map((n) => (
          <li>
            <p lang={n.lang}>“{n.title}”</p>
            <p class="media__meta">{n.outlet} — {n.date[lang]}</p>
            <p class="media__meta"><a href={n.url} target="_blank" rel="noopener noreferrer">{fr ? '[Lire l’article]' : 'Read article'}</a></p>
          </li>
        ))}
      </ul>
    </Section>
  </main>
</Shell>
