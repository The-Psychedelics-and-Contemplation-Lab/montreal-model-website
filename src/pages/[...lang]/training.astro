---
import { Section, Figure, MediaCard } from '@pcl/design-system';
import PageHead from '../../components/PageHead.astro';
import { getEntry } from 'astro:content';
import { withBase, splitAtH2, splitFirstParagraph, revealHeadings, revealLists, externalLinks } from '../../lib/content';
import Shell from '../../components/Shell.astro';
import { langPaths, href } from '../../lib/i18n';
import { u } from '../../lib/url';
export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const fr = lang === 'fr';
const entry = await getEntry('pages', `${lang}/training`);
if (!entry) throw new Error(`Missing content: ${lang}/training`);
const d = entry.data;
const html = externalLinks(revealLists(revealHeadings(withBase(entry.rendered?.html ?? ''))));
// Sections, in the order of the Markdown: London 2026, Brisbane 2026, Montreal 2025, future trainings.
const [, london, brisbane, montreal, future] = splitAtH2(html);
const [montrealIntro, montrealRest] = splitFirstParagraph(montreal);
const brisbanePhoto = fr
  ? { src: u('/images/brisbane-workshop-2026.webp'), alt: 'Six participants de l’atelier de Brisbane, dont le Dr Nicolas Garel, posant côte à côte devant un mur clair.', caption: 'L’atelier Aurora Healthcare, Brisbane, mai 2026.' }
  : { src: u('/images/brisbane-workshop-2026.webp'), alt: 'Six participants of the Brisbane workshop, including Dr. Nicolas Garel, standing side by side in front of a light wall.', caption: 'The Aurora Healthcare workshop, Brisbane, May 2026.' };
const moduleUrl = 'https://media.psychedelicsandcontemplationlab.com/montreal-model/module-1/';
const photos = fr
  ? [
      { src: u('/images/workshop-2025-auditorium.jpg'), alt: 'Un amphithéâtre rempli de participants à l’atelier, tournés vers une diapositive projetée sur le Modèle de Montréal.', caption: 'L’atelier inaugural, les 29 et 30 mai 2025.' },
      { src: u('/images/workshop-2025-team.jpg'), alt: 'L’équipe de l’atelier réunie devant la diapositive-titre du premier atelier sur le Modèle de Montréal, les 29 et 30 mai 2025.', caption: 'L’équipe de l’atelier et les bénévoles.' },
    ]
  : [
      { src: u('/images/workshop-2025-auditorium.jpg'), alt: 'A lecture hall full of workshop participants facing a projected slide about the Montreal Model.', caption: 'The inaugural workshop, May 29–30, 2025.' },
      { src: u('/images/workshop-2025-team.jpg'), alt: 'The workshop team gathered in front of the title slide of the first Montreal Model workshop, May 29–30, 2025.', caption: 'The workshop team and volunteers.' },
    ];
---
<Shell lang={lang} path="/training/" title={d.seoTitle} description={d.description}>
  <main id="main">
    <PageHead eyebrow={d.eyebrow} title={d.title} lead={d.lead} />
    <Section>
      <div class="prose" set:html={london}></div>
    </Section>
    <Section band>
      <div class="prose" set:html={brisbane}></div>
      <div class="training-photos training-photos--single reveal reveal--mask-in">
        <Figure src={brisbanePhoto.src} alt={brisbanePhoto.alt} caption={brisbanePhoto.caption} ratio="wide" drift width={1600} height={1154} class="unveil" />
      </div>
    </Section>
    <Section>
      <div class="prose" set:html={montrealIntro}></div>
      <div class="image-pair training-photos">
        <div class="reveal reveal--mask-in"><Figure src={photos[0].src} alt={photos[0].alt} caption={photos[0].caption} ratio="wide" drift width={1600} height={1200} class="unveil" /></div>
        <div class="reveal reveal--mask-in"><Figure src={photos[1].src} alt={photos[1].alt} caption={photos[1].caption} ratio="wide" drift width={1600} height={1067} class="unveil" /></div>
      </div>
      <div class="prose" set:html={montrealRest}></div>
    </Section>
    <Section band>
      <div class="prose" set:html={future}></div>
    </Section>
    <Section id="online" ariaLabelledby="online-h">
      <h2 id="online-h" class="ruled-heading ruled-heading--drawn reveal-words">{fr ? 'Modules en ligne' : 'Online modules'}</h2>
      <span class="ruled-heading__rule reveal reveal--line" style="--reveal-delay: 240ms" aria-hidden="true"></span>
      <div class="grid grid--2 reveal-group reveal-group--slow modules" style="margin-top: var(--s-8)">
        <MediaCard
          href={href(lang, '/ketamine-mechanism/')}
          eyebrow={fr ? 'Module interactif' : 'Interactive module'}
          title={fr ? 'Comment la kétamine agit sur le cerveau' : 'How ketamine acts on the brain'}
          text={fr ? 'Onze diapositives interactives sur la kétamine et le glutamate : doses subanesthésiques et anesthésiques comparées. En anglais.' : 'Eleven interactive slides on ketamine and glutamate: subanesthetic and anesthetic doses compared.'}
          src={u('/images/module-ketamine-mechanism.webp')}
          alt={fr ? 'Première diapositive du module : « Ketamine and Glutamate: One Blocker, Different Effects at Different Doses », avec un schéma des doses analgésique, subanesthésique et anesthésique.' : 'First slide of the module, “Ketamine and Glutamate: One Blocker, Different Effects at Different Doses”, with a diagram of analgesic, subanesthetic and anesthetic dose ranges.'}
          ratio="wide" class="media-card--hover" />
        <MediaCard
          href={moduleUrl} external
          eyebrow={fr ? 'Module 1' : 'Module 1'}
          title={fr ? 'Le Modèle de Montréal – Module 1' : 'The Montreal Model – Module 1'}
          text={fr ? 'Module de formation interactif (HTML5) présentant le Modèle de Montréal de thérapie par kétamine. Hébergé sur le serveur média du laboratoire.' : 'Interactive HTML5 training module introducing the Montreal Model of ketamine therapy. Hosted on the lab’s media server.'}
          mark={u('/images/montreal-model-mark.webp')} markAlt={fr ? 'Logo du Modèle de Montréal' : 'Montreal Model logo'}
          ratio="wide" class="media-card--hover" />
      </div>
    </Section>
  </main>
</Shell>
