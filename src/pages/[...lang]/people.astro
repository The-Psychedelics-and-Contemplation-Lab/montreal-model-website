---
import { Section } from '@pcl/design-system';
import PageHead from '../../components/PageHead.astro';
import Shell from '../../components/Shell.astro';
import PartnerLogos from '../../components/PartnerLogos.astro';
import { langPaths } from '../../lib/i18n';
import { u } from '../../lib/url';
import { peopleIntro, leads, collaborators, type Person } from '../../content/data/people';
export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const fr = lang === 'fr';
const meta = fr
  ? { title: 'Équipe — Le modèle de Montréal de thérapie par la kétamine', description: 'Les psychiatres et chercheurs qui ont développé le modèle de Montréal à McGill, à l’Hôpital général juif et au CHUM, et leurs collaborateurs.' }
  : { title: 'People — The Montreal Model of Ketamine Therapy', description: 'The psychiatrists and researchers who developed the Montreal Model at McGill, the Jewish General Hospital and the CHUM, and their collaborators.' };
const initials = (n: string) => n.replace(/^Dr\.?\s+/, '').split(/\s+/).map(w => w[0]).slice(0, 2).join('');
---
<Shell lang={lang} path="/people/" title={meta.title} description={meta.description}>
  <main id="main">
    <PageHead eyebrow={fr ? 'Équipe' : 'Team'} title={fr ? 'Personnes' : 'People'} lead={peopleIntro[lang][0]}>
      <p class="lead reveal reveal--blur" style="--reveal-delay: 320ms">{peopleIntro[lang][1]}</p>
    </PageHead>

    <section class="band-plum section" aria-label={fr ? 'Les fondateurs du modèle' : 'The model’s founders'}>
      <div class="container">
        <div class="leads">
          {leads.map((p: Person) => (
            <article class="lead-person">
              <h2 class="reveal-words">{p.name}</h2>
              <div class="lead-person__frame reveal reveal--mask-in">
                <div class="unveil"><img class="lead-person__photo" src={u(`/images/people/${p.photo}`)} alt={p.alt?.[lang] ?? p.name} width="900" height="900" loading="lazy" decoding="async" /></div>
              </div>
              <div class="reveal reveal--fade" style="--reveal-delay: 200ms">
                <p class="lead-person__role">{p.role[lang]}</p>
                <p class="lead-person__aff">{p.affiliation[lang]}</p>
              </div>
              <div class="lead-person__bio reveal reveal--fade" style="--reveal-delay: 320ms"><p>{p.bio?.[lang]}</p></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <Section ariaLabelledby="collab-h">
      <h2 id="collab-h" class="ruled-heading ruled-heading--drawn reveal-words">{fr ? 'Collaborateurs' : 'Collaborators'}</h2>
      <span class="ruled-heading__rule reveal reveal--line" style="--reveal-delay: 240ms" aria-hidden="true"></span>
      <div class="people people--collab reveal-group reveal-group--slow" style="margin-top: var(--s-8)">
        {collaborators.map((p: Person) => (
          <article class="person">
            {p.photo
              ? <div class="person__frame reveal reveal--mask-in"><div class="unveil"><img class="person__photo" src={u(`/images/people/${p.photo}`)} alt={p.alt?.[lang] ?? p.name} width="900" height="900" loading="lazy" decoding="async" /></div></div>
              : <div class="person__placeholder" aria-hidden="true">{initials(p.name)}</div>}
            <div class="person__head">
              <h3>{p.name}</h3>
              <p class="person__role">{p.role[lang]}</p>
              <p class="person__aff">{p.affiliation[lang]}</p>
            </div>
          </article>
        ))}
      </div>
    </Section>

    <PartnerLogos lang={lang} />
  </main>
</Shell>
