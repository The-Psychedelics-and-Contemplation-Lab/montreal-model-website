---
import { Section } from '@pcl/design-system';
import ProsePage from '../../components/ProsePage.astro';
import { langPaths } from '../../lib/i18n';
import { media } from '../../content/data/publications';
export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const fr = lang === 'fr';
---
<ProsePage lang={lang} slug="music" path="/music/">
  <Section id="playlists" band ariaLabelledby="playlists-h">
    <h2 id="playlists-h" class="ruled-heading ruled-heading--drawn text-center reveal-words">{fr ? 'Les Playlists Musicales' : 'Musical Playlists'}</h2>
    <span class="ruled-heading__rule reveal reveal--line" style="--reveal-delay: 240ms" aria-hidden="true"></span>
    <div class="prose text-center">
      <p class="reveal reveal--blur" style="--reveal-delay: 200ms">
        {fr ? 'Pour plus de playlists, consultez notre ' : 'For more playlists, check out our '}
        <a href={media.spotify.profile} target="_blank" rel="noopener noreferrer"><strong>{fr ? 'Spotify page!' : 'Spotify page!'}</strong></a>
      </p>
    </div>
    <div class="playlists reveal-group" style="margin-top: var(--s-8)">
      {media.spotify.playlists.map(({ id, name }) => (
        <div class="card playlist">
          <h3>{name}</h3>
          <iframe
            src={`https://open.spotify.com/embed/playlist/${id}?utm_source=generator&theme=0`}
            title={fr ? `Lecteur Spotify – ${name}` : `Spotify player – ${name}`}
            loading="lazy"
            allow="encrypted-media"
          ></iframe>
          <p class="sans"><a href={`https://open.spotify.com/playlist/${id}`} target="_blank" rel="noopener noreferrer">{fr ? 'Ouvrir dans Spotify' : 'Open in Spotify'}</a></p>
        </div>
      ))}
    </div>
  </Section>
</ProsePage>
