---
import { Section, SectionMark, Figure, Watermark } from '@pcl/design-system';
import { getEntry } from 'astro:content';
import { withBase, splitAtH2, revealHeadings } from '../../lib/content';
import Shell from '../../components/Shell.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { langPaths, href } from '../../lib/i18n';
import { u } from '../../lib/url';
import { site } from '../../site.config';
export const getStaticPaths = langPaths;
const { lang } = Astro.props;
const fr = lang === 'fr';
const entry = await getEntry('pages', `${lang}/home`);
if (!entry) throw new Error('Missing home content');
const html = revealHeadings(withBase(entry.rendered?.html ?? ''));
const d = entry.data;
const h1 = d.title;

// The Markdown body is three h2 sections (Ketamine therapy · The Montreal Model · What the research shows);
// each becomes its own Section with a SectionMark, alternating paper / band.
const sections = splitAtH2(html).filter((s) => s.trim());
const marks = fr
  ? ['Thérapie par kétamine', 'Le modèle', 'Données probantes']
  : ['Ketamine therapy', 'The model', 'Evidence'];

const stats = fr
  ? [
      { value: '2018', label: 'Développement du modèle à McGill, peaufiné depuis dans le système de santé public' },
      { value: 'Des milliers', label: 'de traitements prodigués à des patients souffrant de dépression résistante sévère' },
      { value: '2', label: 'sites hospitaliers à Montréal : Hôpital général juif et CHUM' },
      { value: 'Kétamine + psychothérapie', label: 'Doses multiples associées à un soutien psychologique structuré' },
    ]
  : [
      { value: '2018', label: 'Model first developed at McGill and refined in public healthcare since' },
      { value: 'Thousands', label: 'of treatments provided to patients with severe treatment-resistant depression' },
      { value: '2', label: 'hospital sites in Montreal: Jewish General Hospital and CHUM' },
      { value: 'Ketamine + psychotherapy', label: 'Multiple doses paired with structured psychological support' },
    ];

const schema = [
  site.organizationSchema,
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalWebPage',
    name: d.seoTitle,
    description: d.description,
    inLanguage: fr ? 'fr-CA' : 'en-CA',
    url: site.url + (fr ? '/fr/' : '/'),
    citation: {
      '@type': 'ScholarlyArticle',
      headline: 'The Montreal model: An integrative biomedical-psychedelic approach to ketamine for severe treatment-resistant depression',
      author: 'Garel N, Drury J, Thibault Lévesque J, Goyette N, Lehmann A, Looper K, Erritzoe D, Dames S, Turecki G, Rej S, Greenway KT',
      datePublished: '2023',
      isPartOf: { '@type': 'Periodical', name: 'Frontiers in Psychiatry' },
      sameAs: 'https://doi.org/10.3389/fpsyt.2023.1268832',
    },
  },
];
---
<Shell lang={lang} path="/" title={d.seoTitle} description={d.description} schema={schema}>
  <main id="main">
    <div class="hero hero--mm has-watermark">
      <Watermark motif="waves" position="right" speed={0.12} />
      <div class="container hero__inner">
        <p class="eyebrow reveal reveal--fade">{d.eyebrow}</p>
        <h1 class="reveal" style="--reveal-delay: 60ms">{h1}</h1>
        <p class="lead reveal" style="--reveal-delay: 140ms">{d.lead}</p>
        <div class="cluster reveal reveal--fade" style="--reveal-delay: 220ms">
          <a class="btn btn--primary" href={href(lang, '/clinical-information/')}>{fr ? 'Informations cliniques' : 'Clinical information'}</a>
          <a class="btn btn--secondary" href={href(lang, '/research-publications/')}>{fr ? 'Publications' : 'Research publications'}</a>
        </div>
      </div>
    </div>

    <Section tight class="hero-figure">
      <Figure
        src={u('/images/montreal-model-protocol.jpg')}
        alt={fr
          ? 'Schéma du protocole du Modèle de Montréal : évaluation psychiatrique, préparation initiale, six séances de traitement à la kétamine sur quatre semaines avec préparation et intégration continues, puis maintien, le tout accompagné d’une psychothérapie conventionnelle concomitante.'
          : 'Diagram of the Montreal Model protocol: psychiatric assessment, initial preparation, six ketamine treatment sessions over four weeks with rolling preparation and integration, and maintenance, all accompanied by concomitant conventional psychotherapy.'}
        caption={fr ? 'Le protocole standard du Modèle de Montréal (Garel et coll., 2023). Figure en anglais.' : 'The standard Montreal Model protocol (Garel et al., 2023).'}
        ratio="cinema" width={1600} height={706} loading="eager" class="figure--diagram reveal reveal--scale" />
    </Section>

    <Section band ariaLabelledby="facts-h">
      <h2 id="facts-h" class="visually-hidden">{fr ? 'Faits saillants' : 'Key facts'}</h2>
      <div class="stats reveal-group">
        {stats.map((s) => (
          <div class="stat stat--accent">
            <p class="stat__value">{s.value}</p>
            <p class="stat__label">{s.label}</p>
          </div>
        ))}
      </div>
    </Section>

    {sections.map((chunk, i) => (
      <Section band={i % 2 === 1}>
        <SectionMark label={marks[i] ?? ''} accent />
        <div class="prose prose--centered" set:html={chunk}></div>
      </Section>
    ))}

    <Section band tight>
      <SectionMark label={fr ? 'Référence' : 'Reference'} />
      <div class="reference reveal">
        <p>Garel, N., Drury, J., Thibault Lévesque, J., Goyette, N., Lehmann, A., Looper, K., Erritzoe, D., Dames, S., Turecki, G., Rej, S., &amp; Greenway, K. T. (2023). The Montreal model: An integrative biomedical-psychedelic approach to ketamine for severe treatment-resistant depression. <em>Frontiers in Psychiatry</em>, <em>14</em>, 1268832. <a href="https://doi.org/10.3389/fpsyt.2023.1268832" target="_blank" rel="noopener noreferrer">https://doi.org/10.3389/fpsyt.2023.1268832</a></p>
      </div>
    </Section>

    <ContactBlock lang={lang} mark />
  </main>
</Shell>
